@model YGT.DynamicSurvey.Models.ViewModels.Account.ResetPasswordViewModel
@{ ViewData["Title"] = "Şifreyi Yenile"; }
<section class="auth-page"><div class="container"><div class="auth-card"><h2>Yeni Şifre Belirle</h2><form asp-action="ResetPassword" method="post"><input asp-for="Email" type="hidden"/><input asp-for="Token" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-box"></div><div class="mb-3"><label asp-for="Password"></label><input asp-for="Password" class="form-control"/><span asp-validation-for="Password" class="text-danger"></span></div><div class="mb-4"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control"/><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div><button class="btn btn-primary w-100">Şifremi Yenile</button></form></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
