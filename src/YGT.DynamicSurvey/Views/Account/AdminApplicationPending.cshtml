@{
    ViewData["Title"] =
        "Yönetici Başvurusu";
}

<section class="auth-page">

    <div class="container">

        <div class="auth-card text-center">

            <div style="
                width:70px;
                height:70px;
                display:flex;
                align-items:center;
                justify-content:center;
                margin:0 auto 20px;
                border-radius:50%;
                background:#fff6ed;
                font-size:2rem;">

                ⏳

            </div>


            <h1>
                Yönetici Başvurunuz Alındı
            </h1>


            @if (
                TempData["AdminApplicationSuccess"]
                is not null
            )
            {
                <p class="text-muted">
                    @TempData["AdminApplicationSuccess"]
                </p>
            }
            else
            {
                <p class="text-muted">

                    Yönetici başvurunuz
                    onay bekliyor.

                </p>
            }


            <div class="alert alert-info mt-4">

                Yetkiniz onaylandıktan sonra
                <strong>Yönetici Girişi</strong>
                ekranından giriş yapabilirsiniz.

            </div>


            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-dark mt-3">

                Ana Sayfaya Dön

            </a>

        </div>

    </div>

</section>