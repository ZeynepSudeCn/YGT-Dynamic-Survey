@model YGT.DynamicSurvey.Models.ViewModels.Account.ForgotPasswordViewModel
@{ ViewData["Title"] = "Şifremi Unuttum"; }
<section class="auth-page"><div class="container"><div class="auth-card"><h2>Şifremi Unuttum</h2><p>E-posta adresini gir; şifre yenileme bağlantısını gönderelim.</p>@if(ViewBag.Message is not null){<div class="alert alert-success">@ViewBag.Message</div>}<form asp-action="ForgotPassword" method="post"><div asp-validation-summary="ModelOnly" class="validation-box"></div><div class="mb-4"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email"/><span asp-validation-for="Email" class="text-danger"></span></div><button class="btn btn-primary w-100">Sıfırlama Bağlantısı Gönder</button></form><a asp-action="Login" class="auth-back">← Giriş ekranına dön</a></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
