@{
    ViewData["Title"] = "Hakkımızda";
}

<section class="legal-page py-5">
    <div class="container">
        <div class="legal-card mx-auto">
            <span class="page-badge">Dynamic Survey</span>

            <h1 class="mt-3">Hakkımızda</h1>

            <p class="lead">
                Dynamic Survey, kullanıcıların kolayca anket oluşturmasını,
                paylaşmasını ve sonuçlarını incelemesini sağlayan web tabanlı
                bir anket platformudur.
            </p>

            <p>
                Platform üzerinden farklı soru türleriyle dinamik anketler
                hazırlanabilir. Anketler bağlantı, katılım kodu veya QR kod
                aracılığıyla paylaşılabilir.
            </p>

            <p>
                Kullanıcılar oluşturdukları anketleri yönetebilir, gelen
                cevapları görüntüleyebilir ve sonuçları grafikler üzerinden
                değerlendirebilir.
            </p>

            <div class="row g-3 mt-4">
                <div class="col-12 col-md-4">
                    <div class="feature-box">
                        <h2>Kolay Oluşturma</h2>
                        <p>
                            Farklı soru türleriyle hızlı ve düzenli anketler
                            hazırlanabilir.
                        </p>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="feature-box">
                        <h2>Kolay Paylaşım</h2>
                        <p>
                            Anketler bağlantı, kod ve QR kod ile katılımcılara
                            ulaştırılabilir.
                        </p>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="feature-box">
                        <h2>Anlaşılır Sonuçlar</h2>
                        <p>
                            Toplanan cevaplar grafikler ve özet bilgilerle
                            incelenebilir.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>