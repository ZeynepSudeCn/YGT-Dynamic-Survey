@{
    ViewData["Title"] = "Gizlilik Politikası";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">

                    <h1 class="fw-bold mb-4">
                        Gizlilik Politikası
                    </h1>

                    <p>
                        Bu gizlilik politikası, Dinamik Anket Platformu
                        kullanıcılarının kişisel verilerinin nasıl toplandığını,
                        kullanıldığını ve korunduğunu açıklamak amacıyla
                        hazırlanmıştır.
                    </p>

                    <h2 class="h4 fw-bold mt-4">
                        Toplanan Bilgiler
                    </h2>

                    <p>
                        Platform üzerinden ad soyad, e-posta adresi, kullanıcı
                        hesabı bilgileri, anket cevapları ve sistem işlem
                        kayıtları toplanabilir.
                    </p>

                    <h2 class="h4 fw-bold mt-4">
                        Bilgilerin Kullanımı
                    </h2>

                    <p>
                        Toplanan bilgiler; kullanıcı hesabının oluşturulması,
                        anket hizmetlerinin sunulması, etkinlik ve eğitim
                        süreçlerinin yürütülmesi, sistem güvenliğinin sağlanması
                        ve kullanıcı taleplerinin karşılanması amacıyla
                        kullanılabilir.
                    </p>

                    <h2 class="h4 fw-bold mt-4">
                        Veri Güvenliği
                    </h2>

                    <p>
                        Kullanıcı parolaları açık metin olarak saklanmaz.
                        Yetkisiz erişimi önlemek amacıyla kimlik doğrulama,
                        yetkilendirme ve gerekli teknik güvenlik önlemleri
                        uygulanır.
                    </p>

                    <h2 class="h4 fw-bold mt-4">
                        İletişim
                    </h2>

                    <p>
                        Gizlilik politikasıyla ilgili taleplerinizi
                        [İLETİŞİM E-POSTA ADRESİ] üzerinden iletebilirsiniz.
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>