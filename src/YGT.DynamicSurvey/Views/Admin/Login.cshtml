@model YGT.DynamicSurvey.Models.ViewModels.Admin.AdminLoginViewModel
@{ ViewData["Title"] = "Yönetici Girişi"; }

<section class="auth-page legacy-admin-login">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">
                <div class="card auth-card border-0">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <span class="dashboard-eyebrow">YGT KKU</span>
                            <h2 class="fw-bold mb-2">Yönetici Girişi</h2>
                            <p class="text-muted mb-0">Yönetim paneline erişmek için giriş yapın.</p>
                        </div>
                        <form asp-controller="Admin" asp-action="Login" method="post">
                            <div asp-validation-summary="ModelOnly" class="validation-box"></div>
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" placeholder="Yönetici e-posta adresi" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label"></label>
                                <div class="password-field"><input asp-for="Password" class="form-control" placeholder="Şifrenizi girin" autocomplete="current-password" /><button type="button" data-password-toggle>Göster</button></div>
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="form-check mb-4"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label"></label></div>
                            <div class="text-end mb-3"><a asp-controller="Account" asp-action="ForgotPassword">Şifremi Unuttum</a></div>
                            <button type="submit" class="btn btn-primary w-100">Yönetici Olarak Giriş Yap</button>
                        </form>
                        <div class="text-center mt-4"><a asp-controller="Home" asp-action="Index" class="auth-back">← Ana Sayfaya Dön</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
